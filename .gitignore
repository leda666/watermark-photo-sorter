# 忽略依赖与运行时数据（含个人照片信息，绝不入库）
node_modules/

# OCR 引擎二进制（体积大，按 README 安装）
engine/*
!engine/README.md

# Node.js 运行时（仅打进 Release 完整包，不入仓库）
runtime/

# 运行时生成：日志、学习库、任务快照、线程设置、实际端口
logs/
learnings.json
job_state.json
settings.json
.port
_learning_tmp/

# 引擎安装临时包
*.7z
*.zip

# 系统与编辑器
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log
